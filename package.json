{
  "name": "walnut-expense-analyser",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first local-first desktop finance app for trusted statement analysis.",
  "main": "./out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:electron": "npm run rebuild:native && set WALNUT_DEV_DESKTOP=1&& node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=cjs --outfile=out/main/index.cjs --external:electron --external:better-sqlite3 --external:drizzle-orm --external:drizzle-orm/* --external:@node-rs/argon2 --external:@node-rs/argon2-*",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=out/preload/index.cjs --external:electron",
    "build:renderer": "vite build --outDir out/renderer",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "npm rebuild better-sqlite3",
    "preview": "vite preview",
    "test:unit": "npm run rebuild:native:node && vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.1.1",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.8.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.5",
    "electron-log": "^5.4.3",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^30.5.1",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "serve": "^14.2.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
